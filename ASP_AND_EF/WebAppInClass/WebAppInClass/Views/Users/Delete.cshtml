@model User
@{
    ViewData["Title"] = "Delete User";
}


<div class="container">
    <h1>Delete User</h1>
    <form asp-action="Delete" method="post">

       

        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" readonly />

            
        </div>
        <div class="form-group">
            <label asp-for="UserName" class="control-label"></label>
            <input asp-for="UserName" class="form-control" readonly />

            
        </div>
        <div class="form-group">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" readonly />

            
        </div>

        <div class="form-group">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <div class="form-group">
            <div class="form-check">
                <input asp-for="IsLocked" class="form-check-input" type="checkbox" disabled />
                <label asp-for="IsLocked" class="form-check-label"></label>
            </div>
            <input asp-for="IsLocked" type="hidden" />
            <span asp-validation-for="IsLocked" class="text-danger"></span>
        </div>


        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>



