@model IEnumerable<User>
@{
    ViewData["Title"] = "User";
}


<div class="container">
	<h1>Users</h1>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">New User</a>
    </div>

	<table class="table table-striped table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>User Name</th>
				<th>Email</th>
				<th>Password</th>
				<th>IsLocked</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.Id</td>
					<td>@user.Name</td>
					<td>@user.UserName</td>
					<td>@user.Email</td>
					<td>@user.Password</td>
					<td>@user.IsLocked</td>
					<td>
						<a asp-action="Edit" asp-route-Id="@user.Id" class="btn btn-warning"> Edit  </a>

						<a asp-action="Delete" asp-route-Id="@user.Id" class="btn btn-danger"> Delete  </a>
					</td>


				</tr>
			}
		</tbody>
	</table>
</div>
