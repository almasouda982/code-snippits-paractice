@model IEnumerable<Employee>

<div class="container">
	<h1>Employees</h1>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">New Employee</a>
    </div>

	<table class="table table-striped table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Position</th>
				<th>Salary</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var employee in Model)
			{
				<tr>
					<td>@employee.Id</td>
					<td>@employee.Name</td>
					<td>@employee.Position</td>
					<td>@employee.Salary</td>


				</tr>
			}
		</tbody>
	</table>
</div>
