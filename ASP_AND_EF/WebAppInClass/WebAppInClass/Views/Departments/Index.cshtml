@model IEnumerable<Department>

<div class="container">

    <h1>Departments</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">New </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {

                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Name</td>

                </tr>

            }


        </tbody>

    </table>
</div>