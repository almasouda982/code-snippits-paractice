@using WebAppInClass.Dtos
@model IEnumerable<ManagerDto>
@{
    ViewData["Title"] = "Manager Page";
}

<div class="container">

    <h1>Employees</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New </a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Position</th>
                <th>Salary</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {

                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Name</td>
                    <td>@emp.Position</td>
                    <td>@emp.Salary</td>
                    <td>@emp.DepartmentName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>

            }


        </tbody>

    </table>
</div>